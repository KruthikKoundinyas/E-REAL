# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Email Scheduler" <scheduler@example.com>

# Worker settings
WORKER_CONCURRENCY=5
RATE_LIMIT_EMAILS_PER_MINUTE=10
RATE_LIMIT_MAX=30
